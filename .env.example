# Copy to `.env` in the repository root. Never commit a real key.

APP_MODE=demo

# --- database -------------------------------------------------------------
# Matches `docker compose up -d db`. Point these at an existing PostgreSQL if you have one.
DATABASE_URL=postgresql+asyncpg://torob:torob@127.0.0.1:5437/torob_repair
TEST_DATABASE_URL=postgresql+asyncpg://torob:torob@127.0.0.1:5438/torob_repair_test

# --- http -----------------------------------------------------------------
WEB_ORIGIN=http://127.0.0.1:3000
API_HOST=127.0.0.1
API_PORT=8000
SESSION_COOKIE_SECURE=false

# --- private files --------------------------------------------------------
# Evidence images live outside any web-served directory.
ATTACHMENT_DIR=backend/var/attachments

# --- AI -------------------------------------------------------------------
# `mock` is the default and needs no key, no network and no model run.
AI_MODE=mock
AI_MODEL=deepseek-flash
# Required only when AI_MODE=live:
# AI_API_KEY=
# AI_BASE_URL=
# Recorded tariff in Toman per one million tokens, with the date it was recorded.
# Live mode refuses to start without these, because the spend cap depends on them.
# AI_INPUT_PRICE_PER_MILLION=
# AI_OUTPUT_PRICE_PER_MILLION=
# AI_TARIFF_RECORDED_AT=2026-09-20
# Whole-installation daily live spend cap in Toman (covers every case, appeal and retry).
AI_DAILY_COST_CAP_TOMAN=0

# --- frontend -------------------------------------------------------------
# Server-side only: where Next.js forwards /api requests.
BACKEND_ORIGIN=http://127.0.0.1:8000
