{
  "name": "torob-repair-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "api:types": "openapi-typescript ../contracts/openapi.json -o src/lib/api-types.ts",
    "api:check": "node scripts/check-contract.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "next": "15.5.4",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@playwright/test": "1.56.0",
    "@tailwindcss/postcss": "4.1.14",
    "@types/node": "24.7.0",
    "@types/react": "19.1.11",
    "@types/react-dom": "19.1.9",
    "eslint": "9.37.0",
    "eslint-config-next": "15.5.4",
    "openapi-typescript": "7.9.1",
    "tailwindcss": "4.1.14",
    "typescript": "5.9.3"
  },
  "allowScripts": {
    "@tailwindcss/oxide@4.1.14": true,
    "unrs-resolver@1.12.2": true,
    "sharp@0.34.5": true
  }
}
